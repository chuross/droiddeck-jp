@@ -10471,6 +10473,10 @@ extern CONST_VTBL struct IAmdExtAntiLagApiVtbl d3d_amd_ext_anti_lag_vtbl;
 static void vkd3d_scratch_pool_init(struct d3d12_device *device)
 {
     unsigned int i;
+    char low_memory[8] = {0};
+
+    device->droiddeck_low_memory = vkd3d_get_env_var("DROIDDECK_VKD3D_LOW_MEMORY", low_memory, sizeof(low_memory))
+            && droiddeck_memory_enabled(low_memory);

     for (i = 0; i < VKD3D_SCRATCH_POOL_KIND_COUNT; i++)
     {
@@ -10499,6 +10505,14 @@ static void vkd3d_scratch_pool_init(struct d3d12_device *device)
      * Tuned for Starfield which is the "worst case scenario" so far. */
     device->scratch_pools[VKD3D_SCRATCH_POOL_KIND_INDIRECT_PREPROCESS].scratch_buffer_size =
             VKD3D_SCRATCH_BUFFER_COUNT_INDIRECT_PREPROCESS;
+
+    /* Cache only returned buffers. Required/live allocation sizes are unchanged. */
+    for (i = 0; i < VKD3D_SCRATCH_POOL_KIND_COUNT; i++)
+        device->scratch_pools[i].scratch_buffer_size = droiddeck_scratch_limit(device->droiddeck_low_memory,
+                i == VKD3D_SCRATCH_POOL_KIND_INDIRECT_PREPROCESS, device->scratch_pools[i].scratch_buffer_size);
+
+    if (device->droiddeck_low_memory)
+        INFO("DroidDeck low memory: returned scratch cache 4/8 buffers; command-pool reuse unchanged.\n");
 }

