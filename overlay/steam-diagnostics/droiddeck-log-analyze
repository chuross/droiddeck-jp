#!/usr/bin/python3
"""Summarize observed errors in a standard Proton/session log; never infer timing."""
import argparse
import json
from pathlib import Path
import re

RULES = {
    "steam_connection": re.compile(r"(?:failed|unable|cannot|could not).*?(?:connect.*steam|steam.*connect)|steam.*(?:connection failed|disconnected)", re.I),
    "steam_client": re.compile(r"(?:failed|unable|cannot|could not).*?(?:load|initialize).*?(?:steamclient|steam api)|SteamAPI_Init.*(?:failed|false)", re.I),
    "crash": re.compile(r"unhandled (?:exception|page fault)|segmentation fault|assertion .* failed", re.I),
    "graphics": re.compile(r"(?:failed|unable).*?(?:vulkan|dxvk|vkd3d)|VK_ERROR_[A-Z_]+", re.I),
    "missing_library": re.compile(r"err:module:import_dll|cannot open shared object file", re.I),
}


def analyze(path):
    counts = dict.fromkeys(RULES, 0)
    evidence = {name: [] for name in RULES}
    lines = 0
    with Path(path).open(errors="replace") as log:
        for lines, line in enumerate(log, 1):
            for name, rule in RULES.items():
                if rule.search(line):
                    counts[name] += 1
                    if len(evidence[name]) < 5:
                        evidence[name].append({"line": lines, "text": line.strip()[:500]})
    return {"log": str(path), "lines": lines, "counts": counts, "evidence": evidence,
            "callback_timing": "unknown: standard logs do not establish callback latency",
            "assessment": "matching errors observed" if any(counts.values()) else "no matching errors; success is not established"}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("log", type=Path, help="Proton steam-<appid>.log or session log")
    args = parser.parse_args()
    try:
        print(json.dumps(analyze(args.log), ensure_ascii=False, indent=2))
    except OSError as error:
        parser.exit(1, str(error) + "\n")


if __name__ == "__main__":
    main()
