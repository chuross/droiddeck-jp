+++ b/app/src/main/java/com/droiddeck/launcher/session/SteamConnection.kt
@@ -0,0 +1,51 @@
+package com.droiddeck.launcher.session
+
+import android.content.Context
+import com.droiddeck.launcher.R
+import com.droiddeck.launcher.agent.AgentException
+import com.droiddeck.launcher.agent.AgentGuest
+import org.json.JSONObject
+
+/** Uses Steam's own connection controls through the already running guest bridge. */
+object SteamConnection {
+    data class Snapshot(val offline: Boolean, val running: Boolean)
+
+    fun status(context: Context): Snapshot = request(context, "status")
+
+    fun change(context: Context, offline: Boolean): Snapshot {
+        val session = SessionState.sessionId
+        val result = request(context, if (offline) "offline" else "online")
+        if (!SessionState.running || SessionState.sessionId != session)
+            throw AgentException("SESSION_CHANGED", "The session changed during the request")
+        if (result.offline != offline)
+            throw AgentException("INVALID_STEAM_RESPONSE", "Steam did not confirm the requested mode")
+        // Steam owns loginusers.vdf while running; only remember confirmed changes for next boot.
+        OfflineMode.remember(context, result.offline)
+        return result
+    }
+
+    private fun request(context: Context, operation: String): Snapshot = decode(
+        AgentGuest.call(context, JSONObject().put("kind", "steam_connection").put("op", operation), 16_000),
+    )
+
+    internal fun decode(reply: JSONObject): Snapshot {
+        if (!reply.optBoolean("ok")) throw AgentException(
+            reply.optJSONObject("error")?.optString("code") ?: "STEAM_SWITCH_FAILED",
+            "Steam connection request failed",
+        )
+        val offline = reply.opt("offline") as? Boolean
+        val running = reply.opt("running") as? Boolean
+        if (offline == null || running == null)
+            throw AgentException("INVALID_STEAM_RESPONSE", "Steam did not return a connection state")
+        return Snapshot(offline, running)
+    }
+
+    fun message(error: Throwable): Int = when ((error as? AgentException)?.code) {
+        "GAME_RUNNING" -> R.string.steam_connection_game_running
+        "STEAM_SWITCH_TIMEOUT" -> R.string.steam_connection_timeout
+        "UNSUPPORTED_STEAM" -> R.string.steam_connection_unsupported
+        "STEAM_NOT_READY", "AGENT_UNAVAILABLE", "NO_ACTIVE_SESSION", "NO_TARGET", "NO_DEVTOOLS",
+        "DEVTOOLS_UNREACHABLE", "SESSION_CHANGED" -> R.string.steam_connection_not_ready
+        else -> R.string.steam_connection_failed
+    }
+}
