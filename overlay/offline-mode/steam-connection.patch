diff --git a/app/src/test/java/com/droiddeck/launcher/session/SteamConnectionTest.kt b/app/src/test/java/com/droiddeck/launcher/session/SteamConnectionTest.kt
new file mode 100644
index 0000000..e64bd33
--- /dev/null
+++ b/app/src/test/java/com/droiddeck/launcher/session/SteamConnectionTest.kt
@@ -0,0 +1,124 @@
+package com.droiddeck.launcher.session
+
+import android.content.Context
+import com.droiddeck.launcher.agent.AgentAccess
+import com.droiddeck.launcher.agent.AgentException
+import com.droiddeck.launcher.agent.AgentGuest
+import com.droiddeck.launcher.runtime.LinuxRuntime
+import org.json.JSONObject
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+import java.io.File
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], manifest = Config.NONE)
+class SteamConnectionTest {
+    private lateinit var context: Context
+    private lateinit var loginUsers: File
+
+    @Before fun prepare() {
+        context = RuntimeEnvironment.getApplication()
+        AgentAccess.setCommandsEnabled(context, false)
+        SessionState.running = true
+        SessionState.sessionId = "connection-test"
+        val dir = AgentGuest.dir(context)
+        dir.deleteRecursively()
+        dir.mkdirs()
+        val pid = File("/proc/self/stat").readText().substringBefore(' ').toLong()
+        File(dir, "hello.json").writeText(JSONObject().put("pid", pid).toString())
+        loginUsers = File(LinuxRuntime.rootDir(context), "root/.local/share/Steam/config/loginusers.vdf")
+        loginUsers.parentFile!!.mkdirs()
+        loginUsers.writeText("Steam owns this file while running\n")
+        OfflineMode.remember(context, false)
+    }
+
+    @After fun cleanup() {
+        SessionState.running = false
+        SessionState.sessionId = null
+        AgentGuest.dir(context).deleteRecursively()
+        loginUsers.delete()
+        OfflineMode.remember(context, false)
+    }
+
+    private fun <T> withReply(reply: JSONObject, operation: String, action: () -> T): T {
+        val executor = Executors.newSingleThreadExecutor()
+        val future = executor.submit {
+            val dir = AgentGuest.dir(context)
+            val deadline = System.currentTimeMillis() + 3000
+            var request: File? = null
+            while (request == null && System.currentTimeMillis() < deadline) {
+                request = File(dir, "req").listFiles()?.firstOrNull { it.extension == "json" }
+                if (request == null) Thread.sleep(10)
+            }
+            val file = request ?: throw AssertionError("No guest request")
+            val parsed = JSONObject(file.readText())
+            assertEquals("steam_connection", parsed.getString("kind"))
+            assertEquals(operation, parsed.getString("op"))
+            val answer = File(dir, "resp/${file.name}")
+            answer.parentFile!!.mkdirs()
+            val temp = File(dir, "resp/${file.name}.tmp")
+            temp.writeText(reply.toString())
+            assertTrue(temp.renameTo(answer))
+            file.delete()
+        }
+        try {
+            return action()
+        } finally {
+            try { future.get(4, TimeUnit.SECONDS) } finally { executor.shutdownNow() }
+        }
+    }
+
+    @Test fun confirmedChangeWorksWithoutEnablingDebugCommandsAndOnlyRemembersTheMode() {
+        val reply = JSONObject().put("ok", true).put("offline", true).put("running", false)
+        val result = withReply(reply, "offline") { SteamConnection.change(context, true) }
+        assertTrue(result.offline)
+        assertTrue(OfflineMode.enabled(context))
+        assertFalse(AgentAccess.commandsAllowed(context))
+        assertEquals("Steam owns this file while running\n", loginUsers.readText())
+    }
+
+    @Test fun failedChangeDoesNotChangeTheSavedPreference() {
+        val reply = JSONObject().put("ok", false).put("error", JSONObject().put("code", "GAME_RUNNING"))
+        withReply(reply, "offline") {
+            try {
+                SteamConnection.change(context, true)
+                fail("Should reject a refused switch")
+            } catch (error: AgentException) {
+                assertEquals("GAME_RUNNING", error.code)
+            }
+        }
+        assertFalse(OfflineMode.enabled(context))
+        assertEquals("Steam owns this file while running\n", loginUsers.readText())
+    }
+
+    @Test fun statusDoesNotOverwriteTheNextLaunchPreference() {
+        val reply = JSONObject().put("ok", true).put("offline", true).put("running", false)
+        assertTrue(withReply(reply, "status") { SteamConnection.status(context) }.offline)
+        assertFalse(OfflineMode.enabled(context))
+    }
+
+    @Test fun unconfirmedAndMalformedRepliesCannotChangePreferences() {
+        for (reply in listOf(
+            JSONObject().put("ok", true).put("offline", false).put("running", false),
+            JSONObject().put("ok", true).put("offline", "true").put("running", false),
+        )) {
+            withReply(reply, "offline") {
+                try {
+                    SteamConnection.change(context, true)
+                    fail("Should require a confirmed Boolean state")
+                } catch (error: AgentException) {
+                    assertEquals("INVALID_STEAM_RESPONSE", error.code)
+                }
+            }
+            assertFalse(OfflineMode.enabled(context))
+        }
+    }
+}
