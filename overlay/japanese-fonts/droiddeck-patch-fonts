#!/usr/bin/env python3
"""Apply Japanese font aliases once per real Proton prefix, using its own Proton."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

VERSION = 2
ALIASES = (
    "MS Gothic", "MS PGothic", "MS UI Gothic", "MS Mincho", "MS PMincho",
    "Meiryo", "Meiryo UI", "Yu Gothic", "Yu Gothic UI", "Yu Mincho",
    "ＭＳ ゴシック", "ＭＳ Ｐゴシック", "ＭＳ 明朝", "ＭＳ Ｐ明朝", "メイリオ",
)
LINKS = ("Arial", "Tahoma", "Segoe UI", "Microsoft Sans Serif")
FAMILY = "Noto Sans CJK JP"
BUNDLED_DIR = Path("/usr/local/share/fonts/droiddeck-patch")
COMPAT_FONTS = {
    "IPAMonaGothic": "ipag-mona.ttf", "IPAMonaPGothic": "ipagp-mona.ttf",
    "IPAMonaMincho": "ipam-mona.ttf", "IPAMonaPMincho": "ipamp-mona.ttf",
    "IPAMonaUIGothic": "ipagui-mona.ttf",
}
COMPAT_ALIASES = {
    "MS Gothic": "IPAMonaGothic", "ＭＳ ゴシック": "IPAMonaGothic",
    "MS PGothic": "IPAMonaPGothic", "ＭＳ Ｐゴシック": "IPAMonaPGothic",
    "MS UI Gothic": "IPAMonaUIGothic",
    "MS Mincho": "IPAMonaMincho", "ＭＳ 明朝": "IPAMonaMincho",
    "MS PMincho": "IPAMonaPMincho", "ＭＳ Ｐ明朝": "IPAMonaPMincho",
}


def real_game(command, env):
    if env.get("DROIDDECK_PATCH_FONTS", "1") == "0":
        return False
    if len(command) < 3 or command[1] != "waitforexitandrun":
        return False
    data = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if not data or not Path(data).is_absolute():
        return False
    name = Path(data).name
    return name != "0" and not name.startswith("0-")


def find_font(env):
    family = env.get("DROIDDECK_PATCH_FONT_FAMILY", FAMILY)
    custom = env.get("DROIDDECK_PATCH_FONT_FILE")
    if custom:
        font = Path(custom)
        if not font.is_absolute() or not font.is_file():
            raise RuntimeError("DROIDDECK_PATCH_FONT_FILE must be an absolute readable font path")
        arguments = ["fc-scan", "-f", "%{file}\\n%{family}\\n", str(font)]
    else:
        arguments = ["fc-match", "-f", "%{file}\\n%{family}\\n", family + ":lang=ja"]
    # fc-match can succeed with a Latin-only fallback. Check the family too.
    result = subprocess.run(
        arguments,
        env=env, capture_output=True, text=True, timeout=20, check=True)
    lines = result.stdout.splitlines()
    if len(lines) < 2 or not any(
            name.strip() == family for name in lines[1].split(",")):
        raise RuntimeError("Requested font family unavailable; prefix left unchanged: " + family)
    font = Path(lines[0])
    if not font.is_absolute() or not font.is_file():
        raise RuntimeError("fontconfig returned an unreadable font")
    return font


def reg_string(value):
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def registry_text(filename, family=FAMILY, extras=None, aliases=None):
    extras = extras or {}
    aliases = aliases or {name: family for name in ALIASES}
    lines = ["Windows Registry Editor Version 5.00", "",
             r"[HKEY_CURRENT_USER\Software\Wine\Fonts\Replacements]"]
    lines += [reg_string(name) + "=" + reg_string(target) for name, target in aliases.items()]
    lines += ["", r"[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Fonts]",
              reg_string(family + " (TrueType)") + "=" + reg_string(filename)]
    lines += [reg_string(name + " (TrueType)") + "=" + reg_string(file)
              for name, file in extras.items()]
    lines += ["", r"[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\FontLink\SystemLink]"]
    multi = (filename + "," + family + "\0\0").encode("utf-16le")
    value = "hex(7):" + ",".join("%02x" % byte for byte in multi)
    lines += [reg_string(name) + "=" + value for name in LINKS]
    return "\r\n".join(lines) + "\r\n"


def proton_run(proton, arguments, env):
    # Do not run a host Wine or change Proton's files. It creates/upgrades its own prefix.
    result = subprocess.run([proton, "run", *arguments], env=env,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=120)
    if result.returncode:
        raise RuntimeError("Proton font setup failed (%s): %s" %
                           (result.returncode, result.stdout[-2000:].decode("utf-8", "replace")))


def prepare(command, env):
    if not real_game(command, env):
        return False
    data = Path(env["STEAM_COMPAT_DATA_PATH"])
    family = env.get("DROIDDECK_PATCH_FONT_FAMILY", FAMILY)
    compatibility = not (env.get("DROIDDECK_PATCH_FONT_FAMILY") or env.get("DROIDDECK_PATCH_FONT_FILE"))
    extra_fonts = {name: BUNDLED_DIR / file for name, file in COMPAT_FONTS.items()} if compatibility else {}
    for file in extra_fonts.values():
        if not file.is_file():
            raise RuntimeError("Bundled compatibility font missing; prefix left unchanged: " + str(file))
    try:
        font = find_font(env)
    except (RuntimeError, subprocess.SubprocessError):
        if not compatibility:
            raise
        family = "IPAMonaGothic"
        font = extra_fonts[family]
    stat = font.stat()
    identity = {"version": VERSION, "font": str(font), "family": family,
                "size": stat.st_size, "mtime_ns": stat.st_mtime_ns,
                "compatibility": {name: [str(file), file.stat().st_size, file.stat().st_mtime_ns]
                                  for name, file in extra_fonts.items()}}
    digest = hashlib.sha256(json.dumps(identity, sort_keys=True).encode()).hexdigest()
    prefix = data / "pfx"
    marker = prefix / ".droiddeck-patch-fonts-v1"
    owned = prefix / ".droiddeck-patch-fonts-owned"
    filename = "droiddeck-patch" + font.suffix.lower()
    if family != FAMILY:
        # Keep Noto registered to its own file when switching back and forth.
        tag = hashlib.sha256(family.encode()).hexdigest()[:16]
        filename = "droiddeck-patch-" + tag + font.suffix.lower()
        owned = prefix / (".droiddeck-patch-fonts-owned-" + tag)
    fonts = prefix / "drive_c/windows/Fonts"
    placed = fonts / filename
    extra_names = {name: "droiddeck-patch-" + file.name for name, file in extra_fonts.items()}
    data.mkdir(parents=True, exist_ok=True)
    # Serialize only this helper; Proton retains its own prefix lock.
    with (data / ".droiddeck-patch-fonts.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if marker.is_file() and placed.is_file() and not placed.is_symlink():
            extras_ready = all((fonts / extra_names[name]).is_file()
                               and not (fonts / extra_names[name]).is_symlink()
                               and (fonts / extra_names[name]).stat().st_size == file.stat().st_size
                               for name, file in extra_fonts.items())
            if marker.read_text() == digest and placed.stat().st_size == stat.st_size and extras_ready:
                return True
        # A failed initialization/import gets retried, never marked as complete.
        if not (prefix / "user.reg").is_file():
            proton_run(command[0], ["cmd.exe", "/c", "exit"], env)
        if not (prefix / "user.reg").is_file():
            raise RuntimeError("Proton did not create its prefix")
        fonts.mkdir(parents=True, exist_ok=True)
        if placed.exists() and (not owned.is_file() or owned.read_text() != filename):
            raise RuntimeError("helper font filename already contains a user file")
        for name, source in extra_fonts.items():
            target = fonts / extra_names[name]
            owner = prefix / (".droiddeck-patch-fonts-owned-" + source.name)
            if target.exists() and (not owner.is_file() or owner.read_text() != target.name):
                raise RuntimeError("helper font filename already contains a user file: " + target.name)
        owned.write_text(filename)
        staged_font = fonts / (filename + ".tmp")
        staged_font.unlink(missing_ok=True)
        shutil.copy2(font, staged_font)
        staged_font.replace(placed)
        for name, source in extra_fonts.items():
            target = fonts / extra_names[name]
            (prefix / (".droiddeck-patch-fonts-owned-" + source.name)).write_text(target.name)
            staging = target.with_name(target.name + ".tmp")
            staging.unlink(missing_ok=True)
            shutil.copy2(source, staging)
            staging.replace(target)
        # Wine imports the registry file through the matching Proton, rather than
        # editing a live user.reg or system.reg directly.
        with tempfile.TemporaryDirectory(prefix="droiddeck-patch-") as temporary:
            registry = Path(temporary) / "fonts.reg"
            aliases = {name: COMPAT_ALIASES.get(name, family) for name in ALIASES} if compatibility else None
            registry.write_bytes(registry_text(filename, family, extra_names, aliases).encode("utf-16"))
            windows_path = "Z:" + str(registry).replace("/", "\\")
            proton_run(command[0], ["reg.exe", "import", windows_path], env)
        staged = prefix / ".droiddeck-patch-fonts-v1.tmp"
        staged.write_text(digest)
        staged.replace(marker)
        mode = "IPAMona compatibility fonts; fallback " if compatibility else ""
        print("droiddeck-patch: Japanese fonts ready for " + data.name + ": " + mode + family, file=sys.stderr)
        return True


if __name__ == "__main__":
    try:
        prepare(sys.argv[1:], os.environ.copy())
    except Exception as error:
        print("droiddeck-patch: " + str(error), file=sys.stderr)
        sys.exit(1)

