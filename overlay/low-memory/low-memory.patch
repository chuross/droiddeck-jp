diff --git a/app/src/main/java/com/droiddeck/launcher/session/SessionPrefs.kt b/app/src/main/java/com/droiddeck/launcher/session/SessionPrefs.kt
index 1df9babf..a4c329f1 100644
--- a/app/src/main/java/com/droiddeck/launcher/session/SessionPrefs.kt
+++ b/app/src/main/java/com/droiddeck/launcher/session/SessionPrefs.kt
@@ -31,6 +31,23 @@ object SessionPrefs {
     fun backActionsOrder(inverted: Boolean): Int =
         if (inverted) BACK_QAM_THEN_MENU else BACK_MENU_THEN_QAM

+    /** Global across Steam, Desktop and direct app sessions; migrate the former shared profile. */
+    fun lowMemoryEnabled(context: Context): Boolean {
+        val settings = prefs(context)
+        if (!settings.contains("jpLowMemory")) {
+            val previous = runCatching {
+                GameEnvironmentStore.read(context).shared["DROIDDECK_LOW_MEMORY"]?.lowercase() in listOf("1", "on", "true", "yes")
+            }.getOrDefault(false)
+            settings.edit().putBoolean("jpLowMemory", previous).apply()
+        }
+        return settings.getBoolean("jpLowMemory", false)
+    }
+
+    fun setLowMemoryEnabled(context: Context, on: Boolean) {
+        prefs(context).edit().putBoolean("jpLowMemory", on).apply()
+        GameEnvironmentStore.publish(context)
+    }
+
     private fun prefs(context: Context) = context.getSharedPreferences("session", Context.MODE_PRIVATE)

     /** Whether the launcher hides Android's status and navigation bars. */
