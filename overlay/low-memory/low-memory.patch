+# Shared low-memory settings are resolved before gamescope starts MangoApp.
+# This helper emits only fixed assignments, never values from the config file.
+if [ -z "${BL_INSIDE:-}" ]; then
+  _bl_lm_allocator=OFF
+  if [ -x /usr/local/bin/droiddeck-low-memory ]; then
+    while IFS= read -r setting; do
+      case "$setting" in
+        "export DROIDDECK_SESSION_LOW_MEMORY=0") export DROIDDECK_SESSION_LOW_MEMORY=0 ;;
+        "export DROIDDECK_SESSION_LOW_MEMORY=1") export DROIDDECK_SESSION_LOW_MEMORY=1 ;;
+        "export DROIDDECK_LOW_MEMORY=0") export DROIDDECK_LOW_MEMORY=0 ;;
+        "export DROIDDECK_LOW_MEMORY=1") export DROIDDECK_LOW_MEMORY=1 ;;
+        "export FEX_DYNAMICL1CACHE=1") export FEX_DYNAMICL1CACHE=1 ;;
+        "export FEX_DISABLEL2CACHE=1") export FEX_DISABLEL2CACHE=1 ;;
+        "export MANGOHUD=0") export MANGOHUD=0 ;;
+        "export DXVK_HUD=0") export DXVK_HUD=0 ;;
+        "export GALLIUM_HUD=") export GALLIUM_HUD= ;;
+        "export SteamNoOverlayUI=1") export SteamNoOverlayUI=1 ;;
+        "export BL_MANGOAPP=0") export BL_MANGOAPP=0 ;;
+        "export DROIDDECK_SESSION_LOW_MEMORY_ALLOCATOR=1") export DROIDDECK_SESSION_LOW_MEMORY_ALLOCATOR=1 ;;
+        "export DROIDDECK_SESSION_MEMORY_PROFILER=1") export DROIDDECK_SESSION_MEMORY_PROFILER=1 ;;
+      esac
+    done < <(/usr/local/bin/droiddeck-low-memory)
+  fi
+  if [ "${DROIDDECK_SESSION_LOW_MEMORY_ALLOCATOR:-0}" = 1 ]; then
+    # Child loaders see these tunables before their malloc initializes. Save the
+    # baseline so an individual game can opt out without affecting Steam's heap.
+    export DROIDDECK_SESSION_GLIBC_BASE="${GLIBC_TUNABLES:-}"
+    if _bl_low_glibc=$(/usr/local/bin/droiddeck-low-memory --allocator); then
+      export GLIBC_TUNABLES="$_bl_low_glibc"
+      export DROIDDECK_SESSION_GLIBC_LOW="$GLIBC_TUNABLES"
+      _bl_lm_allocator=ON
+      echo "== low-memory: allocator top_pad=1MB arena_max=2 trim_threshold=128KB"
+    else
+      _bl_lm_allocator=FAILED
+    fi
+    unset _bl_low_glibc
+  fi
+  case "${DROIDDECK_SESSION_LOW_MEMORY:-}" in
+    1) _bl_lm_mode=ON ;;
+    0) _bl_lm_mode=OFF ;;
+    *) _bl_lm_mode=UNKNOWN ;;
+  esac
+  echo "== low-memory: mode=$_bl_lm_mode allocator=$_bl_lm_allocator profiler_requested=${DROIDDECK_SESSION_MEMORY_PROFILER:-0}"
+  if [ "$_bl_lm_mode" = UNKNOWN ]; then
+    echo "== low-memory: mode unresolved; settings helper missing or failed"
+  fi
+  unset _bl_lm_mode _bl_lm_allocator
