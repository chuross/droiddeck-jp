#!/usr/bin/python3
"""Only emit fixed shell assignments; never evaluate user-supplied settings."""
import json
import os
from pathlib import Path
import re
import sys

MODE = "DROIDDECK_LOW_MEMORY"
SESSION = "DROIDDECK_SESSION_LOW_MEMORY"
PROFILER = "DROIDDECK_MEMORY_PROFILER"
GPU = "DROIDDECK_GPU_MEMORY_MB"
ALLOCATOR = "DROIDDECK_LOW_MEMORY_ALLOCATOR"
BASE_GLIBC = "DROIDDECK_SESSION_GLIBC_BASE"
LOW_GLIBC = "DROIDDECK_SESSION_GLIBC_LOW"
MALLOC = {
    "glibc.malloc.top_pad": "1048576",
    "glibc.malloc.arena_max": "2",
    "glibc.malloc.trim_threshold": "131072",
}


def enabled(value):
    return str(value).lower() in ("1", "on", "true", "yes")


def low_enabled(env):
    # The session's startup snapshot overrides legacy per-game mode variables.
    return enabled(env.get(SESSION, env.get(MODE, "0")))


def shared_settings(env):
    result = dict(env)
    try:
        config = json.loads((Path.home() / ".config/droiddeck/game-environment.json").read_text())
        if config.get("version") != 1:
            raise ValueError("unsupported configuration")
        for key, value in config.get("shared", {}).items():
            if key in (MODE, PROFILER, ALLOCATOR):
                if value is None:
                    result.pop(key, None)
                elif isinstance(value, str):
                    result[key] = value
        if "sessionLowMemory" in config:
            value = config["sessionLowMemory"]
            if not isinstance(value, bool):
                raise ValueError("invalid session low memory setting")
            result[MODE] = "1" if value else "0"
    except FileNotFoundError:
        pass
    except (OSError, ValueError, TypeError, AttributeError):
        print("low-memory: invalid shared settings; using inherited settings", file=sys.stderr)
    return result


def allocator_tunables(value):
    # Preserve rseq and unrelated user tunables, replacing every duplicate of our
    # three malloc keys. Do not change tcache, mmap thresholds or cache contents.
    entries = [entry for entry in value.split(":") if entry and entry.partition("=")[0] not in MALLOC]
    return ":".join(entries + [key + "=" + value for key, value in MALLOC.items()])


def allocator_environment(env):
    if low_enabled(env) and enabled(env.get(ALLOCATOR, "1")):
        return dict(env, GLIBC_TUNABLES=allocator_tunables(env.get("GLIBC_TUNABLES", "")))
    # A game can opt out of shared low-memory allocation. Restore the pre-session
    # value only if a game profile has not supplied its own GLIBC_TUNABLES.
    if (BASE_GLIBC in env and LOW_GLIBC in env
            and env.get("GLIBC_TUNABLES") == env[LOW_GLIBC]):
        return dict(env, GLIBC_TUNABLES=env[BASE_GLIBC])
    return env


def game_environment(env):
    env = allocator_environment(env)
    if not low_enabled(env):
        return env
    result = dict(env)
    result.update(FEX_DYNAMICL1CACHE="1", FEX_DISABLEL2CACHE="1", MANGOHUD="0",
                  DXVK_HUD="0", GALLIUM_HUD="", SteamNoOverlayUI="1")
    # Steam preloads its Linux overlay into Proton. Remove only these libraries.
    preload = [p for p in re.split(r"[:\s]+", result.get("LD_PRELOAD", "")) if p]
    blocked = {"gameoverlayrenderer.so", "libMangoHud.so", "libMangoHud_dlsym.so"}
    result["LD_PRELOAD"] = ":".join(p for p in preload if p.rsplit("/", 1)[-1] not in blocked)
    if "VK_INSTANCE_LAYERS" in result:
        result["VK_INSTANCE_LAYERS"] = ":".join(
            layer for layer in result["VK_INSTANCE_LAYERS"].split(":") if layer != "VK_LAYER_MANGOHUD_overlay")
    overrides = result.get("WINEDLLOVERRIDES", "").strip().rstrip(";")
    result["WINEDLLOVERRIDES"] = (overrides + ";" if overrides else "") + "gameoverlayrenderer,gameoverlayrenderer64=d"
    # Opt-in DXVK DXGI reported memory; not a physical allocation cap.
    # GE also uses DXVK DXGI for D3D12/VKD3D-Proton. The patched DXVK
    # applies these same options to QueryVideoMemoryInfo budgets.
    budget = result.get(GPU, "0")
    if re.fullmatch(r"[0-9]{1,5}", budget) and 256 <= int(budget) <= 16384:
        own = result.get("DXVK_CONFIG", "").strip().rstrip(";")
        options = "dxgi.maxDeviceMemory = %s; dxgi.maxSharedMemory = %s" % (budget, budget)
        result["DXVK_CONFIG"] = (own + "; " if own else "") + options
    elif budget != "0":
        print("low-memory: ignored invalid GPU memory report (256..16384 MB or 0)", file=sys.stderr)
    print("low-memory: game overlay/HUD off, FEX dynamic L1 on/L2 off", file=sys.stderr)
    return result


def main():
    env = shared_settings(os.environ)
    low = enabled(env.get(MODE, "0"))
    if sys.argv[1:] == ["--allocator"]:
        # Returned as data to a quoted shell assignment, never shell code.
        print(allocator_tunables(os.environ.get("GLIBC_TUNABLES", "")), end="")
        return 0
    print("export DROIDDECK_SESSION_LOW_MEMORY=" + ("1" if low else "0"))
    print("export DROIDDECK_LOW_MEMORY=" + ("1" if low else "0"))
    if low:
        print("export BL_MANGOAPP=0")
        for name, value in (("FEX_DYNAMICL1CACHE", "1"), ("FEX_DISABLEL2CACHE", "1"),
                            ("MANGOHUD", "0"), ("DXVK_HUD", "0"), ("GALLIUM_HUD", ""),
                            ("SteamNoOverlayUI", "1")):
            print("export " + name + "=" + value)
        if enabled(env.get(ALLOCATOR, "1")):
            print("export DROIDDECK_SESSION_LOW_MEMORY_ALLOCATOR=1")
    if enabled(env.get(PROFILER, "1" if low else "0")):
        print("export DROIDDECK_SESSION_MEMORY_PROFILER=1")
    return 0


if __name__ == "__main__":
    sys.exit(main())
