#!/usr/bin/python3
"""Reclaim Steam's CEF caches in the existing agent, without killing its UI."""
import json
import threading
import time
from pathlib import Path

POLL = 5
COOLDOWN = 120
PRESSURE_KB = 1536 * 1024
TIMEOUT = 2
STEAM_APP = 769


def game_focus(path):
    try:
        app = json.loads(path.read_text()).get("focusedApp")
        return app if type(app) is int and app > 0 and app != STEAM_APP else None
    except (OSError, ValueError, AttributeError):
        return None


def available_kb(proc):
    try:
        for line in (proc / "meminfo").read_text().splitlines():
            if line.startswith("MemAvailable:"):
                return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    return None


def steam_pss(proc):
    """Sum only same-UID web helpers. Partial/unreadable totals remain unknown."""
    count, total, unknown = 0, 0, 0
    try:
        status = (proc / "self/status").read_text().splitlines()
        uid = next(line.split()[1] for line in status if line.startswith("Uid:"))
        directories = list(proc.iterdir())
    except (OSError, StopIteration, IndexError):
        return {"pss_kb": None, "processes": None, "unreadable": None}
    for directory in directories:
        if not directory.name.isdigit():
            continue
        try:
            status = (directory / "status").read_text().splitlines()
            if next(line.split()[1] for line in status if line.startswith("Uid:")) != uid:
                continue
            with (directory / "cmdline").open("rb") as stream:
                binary = stream.read(4096).split(b"\0", 1)[0].rsplit(b"/", 1)[-1]
            if binary != b"steamwebhelper":
                continue
        except (OSError, StopIteration, IndexError):
            continue
        count += 1
        try:
            rows = (directory / "smaps_rollup").read_text().splitlines()
            pss = next(int(row.split()[1]) for row in rows if row.startswith("Pss:"))
            total += pss
        except (OSError, ValueError, StopIteration, IndexError):
            unknown += 1
    return {"pss_kb": total if count and not unknown else None,
            "processes": count, "unreadable": unknown}


def notify(agent_dir, targets, websocket):
    # One global CEF memory-pressure notification reaches all Chromium processes.
    # Do not discard live JS state, freeze/kill renderers, or disable notifications.
    candidates = [target for target in targets(agent_dir, timeout=TIMEOUT)
                  if target.get("title") == "SharedJSContext" and target.get("webSocketDebuggerUrl")]
    if not candidates:
        raise RuntimeError("Steam SharedJSContext is not ready")
    connection = websocket(candidates[0]["webSocketDebuggerUrl"], TIMEOUT)
    try:
        connection.send(json.dumps({"id": 1, "method": "Memory.simulatePressureNotification",
                                    "params": {"level": "critical"}}))
        deadline = time.monotonic() + TIMEOUT
        while time.monotonic() < deadline:
            message = json.loads(connection.recv())
            if message.get("id") != 1:
                continue
            if "error" in message:
                raise RuntimeError("CEF does not accept memory-pressure notifications")
            if "result" in message:
                return
            raise RuntimeError("Invalid CEF memory-pressure response")
        raise TimeoutError("CEF memory-pressure response timed out")
    finally:
        connection.close()


class Reclaimer:
    """Rate-limit successes AND failures, including repeated launch/menu transitions."""

    def __init__(self):
        self.game = None
        self.pending = False
        self.last_attempt = None

    def due(self, now, game, requested, available):
        if game is None and self.game is not None:
            self.pending = False
        if requested or (game is not None and game != self.game):
            self.pending = True
        self.game = game
        # A pending launch may precede the first game window; otherwise leave the
        # visible Steam UI alone. Unknown system memory does not trigger repeats.
        if not self.pending and (game is None or available is None or available >= PRESSURE_KB):
            return False
        if self.last_attempt is not None and now - self.last_attempt < COOLDOWN:
            return False
        self.pending = False
        self.last_attempt = now
        return True


def watch(agent_dir, targets, websocket, log, proc=Path("/proc")):
    policy = Reclaimer()
    request = agent_dir / "steam-memory-request"
    log("steam-memory: CEF reclaim on launch/game focus; pressure retries at most every 120s")
    while True:
        time.sleep(POLL)
        requested = False
        try:
            request.unlink()
            requested = True
        except OSError:
            pass
        game = game_focus(agent_dir / "focus.json")
        available = available_kb(proc)
        if not policy.due(time.monotonic(), game, requested, available):
            continue
        before = steam_pss(proc)
        try:
            notify(agent_dir, targets, websocket)
        except Exception as error:
            # Never include target URLs, titles, arguments or exception messages:
            # they may contain account data. Failure is diagnostic, not fatal.
            log("steam-memory: reclaim unavailable (%s); Steam/game left running" % type(error).__name__)
            continue
        time.sleep(2)
        after = steam_pss(proc)
        delta = (after["pss_kb"] - before["pss_kb"]
                 if before["pss_kb"] is not None and after["pss_kb"] is not None else None)
        log("steam-memory: " + json.dumps({"before": before, "after": after,
            "observed_pss_delta_kb": delta, "mem_available_kb": available}, separators=(",", ":")))


def start(agent_dir, targets, websocket, log):
    # The agent already lives for the session. A daemon thread adds no standalone
    # Python resident and ends with the agent; it never signals any other process.
    thread = threading.Thread(target=watch, args=(agent_dir, targets, websocket, log),
                              daemon=True, name="steam-memory")
    thread.start()
    return thread
